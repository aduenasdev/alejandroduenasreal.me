---
// Dos cintas que se cruzan y se desplazan en sentidos contrarios. Decorativas: aria-hidden.
import { portada } from '../data/perfil';
const repite = (xs: string[]) => [...xs, ...xs, ...xs, ...xs];
---

<div class="cintas relative my-16 h-[150px] overflow-hidden md:my-20 md:h-[170px]" aria-hidden="true">
  <div class="cinta absolute left-[-5%] top-[22px] w-[110%] md:top-[38px] -rotate-[2.6deg] bg-[var(--cinta)] py-3.5 text-[var(--cinta-tinta)]">
    <div class="pista">
      {repite(portada.cintaUno).map((p) => <span class="flex items-center gap-6 pr-6">{p}<span class="text-senal">◆</span></span>)}
    </div>
  </div>
  <div class="cinta absolute left-[-5%] top-[78px] w-[110%] rotate-[1.8deg] bg-senal py-3.5 text-noche md:top-[72px]">
    <div class="pista pista-inversa">
      {repite(portada.cintaDos).map((p) => <span class="flex items-center gap-6 pr-6">{p}<span>◆</span></span>)}
    </div>
  </div>
</div>
