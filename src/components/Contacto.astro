---
// Bloque «Hablemos»: el correo en grande, Escríbeme (mailto), Copiar (sin navegar) y enlaces.
import { perfil, contacto } from '../data/perfil';
---

<div class="contacto tarjeta relative overflow-hidden px-6 py-12 md:px-14 md:py-16">
  <div class="trama pointer-events-none absolute -right-24 -top-24 size-[300px] rounded-full md:-right-16 md:-top-28 md:size-[380px]" aria-hidden="true"></div>
  <div class="relative">
    <p class="etiqueta">Hablemos</p>
    <h2 class="titulo-seccion max-w-[18ch]">{contacto.titulo}</h2>
    <p class="mt-5 max-w-[46ch] text-tinta-2">{contacto.texto}</p>
    <p class="mt-8">
      <a
        href={`mailto:${perfil.correo}`}
        class="correo break-all font-display text-[clamp(22px,3.4vw,40px)] font-semibold underline decoration-senal dia:decoration-enlace decoration-[3px] underline-offset-[6px]"
        set:text={perfil.correo}
      />
    </p>
    <div class="acciones mt-8 flex flex-wrap gap-3">
      <a href={`mailto:${perfil.correo}`} class="pildora pildora-llena">Escríbeme</a>
      <button type="button" class="pildora solo-js" data-copiar={perfil.correo}>Copiar</button>
    </div>
    <div class="acciones mt-6 flex flex-wrap gap-3">
      <a href={perfil.linkedin} class="pildora" rel="me noopener">LinkedIn ↗</a>
      <a href={perfil.github} class="pildora" rel="me noopener">GitHub ↗</a>
    </div>
  </div>
</div>

<div
  class="aviso pointer-events-none fixed bottom-6 left-1/2 z-50 -translate-x-1/2 translate-y-4 rounded-full bg-tinta px-6 py-3 font-display text-[15px] font-semibold text-fondo opacity-0 transition-all"
  role="status"
  aria-live="polite"
  data-aviso
>
</div>

<script>
  const aviso = document.querySelector<HTMLElement>('[data-aviso]');
  let temporizador: number | undefined;
  const avisa = (texto: string) => {
    if (!aviso) return;
    aviso.textContent = texto;
    aviso.classList.remove('opacity-0', 'translate-y-4');
    window.clearTimeout(temporizador);
    temporizador = window.setTimeout(() => aviso.classList.add('opacity-0', 'translate-y-4'), 2600);
  };
  document.querySelector<HTMLButtonElement>('[data-copiar]')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const correo = (e.currentTarget as HTMLButtonElement).dataset.copiar ?? '';
    try {
      await navigator.clipboard.writeText(correo);
      avisa(`Correo copiado: ${correo}`);
    } catch {
      avisa(`No se pudo copiar. El correo es ${correo}`);
    }
  });
</script>
