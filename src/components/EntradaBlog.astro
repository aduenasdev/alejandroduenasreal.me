---
// Página de una nota: cabecera, portada, cuerpo, contacto y nota anterior/siguiente.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fechaLarga, minutosLectura, publicadas, urlEntrada, colorTipo, type Entrada } from '../blog';
import { rutaBlog, textos as t } from '../i18n';
import { perfil } from '../data/perfil';

interface Props { entrada: Entrada }
const { entrada } = Astro.props;
const { titulo, descripcion, fecha, tipo, serie, portada, portadaAlt, etiquetas } = entrada.data;
const { Content } = await render(entrada);
const mismas = await publicadas();
const i = mismas.findIndex((e) => e.id === entrada.id);
const nueva = i > 0 ? mismas[i - 1] : undefined;
const vieja = i < mismas.length - 1 ? mismas[i + 1] : undefined;
const url = new URL(urlEntrada(entrada), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: descripcion,
  datePublished: fecha.toISOString(),
  inLanguage: 'es',
  url,
  mainEntityOfPage: url,
  image: new URL('/og.png', Astro.site).href,
  keywords: etiquetas.join(', '),
  author: { '@type': 'Person', name: perfil.nombre, url: perfil.sitio },
};
---

<Base titulo={titulo} descripcion={descripcion} jsonLd={jsonLd} tipoOg="article" rss={{ titulo: t.rss, href: `${rutaBlog}rss.xml` }}>
  <article class="contenedor max-w-[calc(760px+56px)] pt-8">
    <p><a href={rutaBlog} class="font-display text-[14.5px] font-semibold text-tinta-2 no-underline hover:text-tinta">{t.todas}</a></p>
    <p class="mt-8 flex flex-wrap items-center gap-3 font-display text-[13px] font-semibold">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-borde px-2.5 py-0.5">
        <span class="size-2 rounded-full" style={`background: ${colorTipo[tipo]}`} aria-hidden="true"></span>{t.tipos[tipo]}
      </span>
      {serie && <span class="text-tinta-2">{serie}</span>}
    </p>
    <h1 class="mt-4 font-display text-[clamp(32px,4.4vw,50px)] font-semibold leading-[1.1] tracking-[-.01em]">{titulo}</h1>
    <p class="mt-5 flex flex-wrap gap-x-2 text-[15px] text-tinta-2">
      <span>{t.publicado} <time datetime={fecha.toISOString().slice(0, 10)}>{fechaLarga(fecha)}</time></span>
      <span aria-hidden="true">·</span>
      <span>{minutosLectura(entrada.body)} {t.minutos}</span>
    </p>
    {portada && <Image src={portada} alt={portadaAlt ?? ''} widths={[760, 1520]} sizes="(min-width: 820px) 760px, 100vw" class="mt-8 w-full rounded-[22px]" loading="eager" />}
    <div class="articulo-cuerpo mt-10">
      <Content />
    </div>
    <aside class="tarjeta mt-14 flex flex-col gap-4 p-7 md:flex-row md:items-center md:justify-between">
      <p class="font-display text-[20px] font-semibold">{t.teHaServido}</p>
      <a href="/#hablemos" class="pildora pildora-llena self-start">{t.hablemos}</a>
    </aside>
    {(vieja || nueva) && (
      <nav class="mt-8 grid gap-4 md:grid-cols-2" aria-label={t.notas}>
        {vieja ? <a href={urlEntrada(vieja)} class="tarjeta block p-5 no-underline hover:border-tinta-3"><span class="etiqueta">← {t.anterior}</span><span class="mt-2 block font-display font-semibold">{vieja.data.titulo}</span></a> : <span />}
        {nueva && <a href={urlEntrada(nueva)} class="tarjeta block p-5 text-right no-underline hover:border-tinta-3"><span class="etiqueta">{t.siguiente} →</span><span class="mt-2 block font-display font-semibold">{nueva.data.titulo}</span></a>}
      </nav>
    )}
  </article>
</Base>
