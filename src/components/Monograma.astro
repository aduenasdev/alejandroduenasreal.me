---
// Monograma «AD» en trama risográfica: letras en trama azul sobre un círculo en trama amarilla.
// Se usa cuando no hay retrato en src/assets/.
interface Props { class?: string }
const { class: clase = '' } = Astro.props;
const id = `m${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={clase} viewBox="0 0 200 200" role="img" aria-label="Monograma AD de Alejandro Dueñas">
  <defs>
    <pattern id={`${id}-am`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(15)">
      <circle cx="3.5" cy="3.5" r="2.6" fill="#3fcf8e" />
    </pattern>
    <pattern id={`${id}-az`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <circle cx="2.5" cy="2.5" r="2.15" fill="#0e7e4e" />
    </pattern>
  </defs>
  <circle cx="100" cy="100" r="92" fill={`url(#${id}-am)`} />
  <!-- Ligero desfase de registro entre tintas, como en una risografía -->
  <g fill="none" stroke-width="17" stroke-linecap="round" stroke-linejoin="round" transform="translate(2 1.5)">
    <path d="M38 138 L67 62 L96 138 M50 112 H84" stroke={`url(#${id}-az)`} />
    <path d="M114 62 V138 H125 A38 38 0 0 0 125 62 Z" stroke={`url(#${id}-az)`} />
  </g>
</svg>
