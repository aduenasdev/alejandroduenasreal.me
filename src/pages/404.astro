---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe." noindex>
  <section class="contenedor pt-16 pb-8">
    <p class="etiqueta">Error 404</p>
    <h1 class="titulo-seccion">Esta página no existe.</h1>
    <p class="mt-5 max-w-[46ch] text-tinta-2">Puede que el enlace sea antiguo o que la dirección tenga una errata.</p>
    <p class="mt-8"><a href="/" class="pildora pildora-llena">← Volver al inicio</a></p>
  </section>
</Base>
